    "site:preview": "cd web && astro preview",
    "site:check": "cd web && astro check",
    "site:assets": "node web/scripts/compose-product-images.mjs && node web/scripts/generate-share-image.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "expo-doctor"
  },
  "dependencies": {
