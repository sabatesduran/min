{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "min-site",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./web/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "min.didac.dev",
      "custom_domain": true
    }
  ]
}
